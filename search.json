---
layout: null
sitemap: false
---
[{% for p in site.products %}{% case p.category %}{% when 'girls' %}{% assign cfa = 'دخترانه' %}{% when 'boys' %}{% assign cfa = 'پسرانه' %}{% when 'bags-shoes' %}{% assign cfa = 'کیف و کفش' %}{% when 'crown-wand' %}{% assign cfa = 'تاج و عصا' %}{% else %}{% assign cfa = 'اکسسوری' %}{% endcase %}{"title":{{ p.title | jsonify }},"url":{{ p.url | relative_url | jsonify }},"category":{{ p.category | jsonify }},"category_fa":{{ cfa | jsonify }},"image":{% assign im = p.images[0] %}{% if im %}{% capture u %}{% include thumb.html src=im %}{% endcapture %}{{ u | strip | jsonify }}{% else %}""{% endif %},"price":{{ p.price | default: 0 | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
