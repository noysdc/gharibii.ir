---
layout: null
sitemap: false
---
[{% for p in site.products %}{"title":{{ p.title | jsonify }},"url":{{ p.url | relative_url | jsonify }},"category":{{ p.category | jsonify }},"image":{% assign im = p.images[0] %}{% if im %}{% capture u %}{% include img.html src=im %}{% endcapture %}{{ u | strip | jsonify }}{% else %}""{% endif %},"price":{{ p.price | default: 0 | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
